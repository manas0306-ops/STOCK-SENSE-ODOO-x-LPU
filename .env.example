# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL default port is 5432)
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/stocksense_db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=stocksense_db

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
ALLOW_DEMO_OTP=false

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
